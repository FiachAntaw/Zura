        <cura:setting key="inset_direction">outside_in</cura:setting>
        <cura:setting key="raft_airgap">0.15</cura:setting>
        <cura:setting key="raft_base_line_spacing">4.0</cura:setting>
        <cura:setting key="raft_base_thickness">0.26</cura:setting>
        <cura:setting key="retraction_hop">0.2</cura:setting>
        <cura:setting key="speed_print_layer_0">30.0</cura:setting>
        <cura:setting key="speed_travel">200.0</cura:setting>
        <cura:setting key="support_line_distance">3.0</cura:setting>
        <cura:setting key="support_xy_distance">0.16</cura:setting>
        <cura:setting key="wall_0_material_flow">115</cura:setting>
