        <version>1</version>
        <color_code>#ffffff</color_code>
        <description>Z-PLA by Zortrax. Settings ported from Z-Suite.</description>
    </metadata>
    <properties>
        <density>1.24</density>
        <diameter>1.75</diameter>
    </properties>
    <settings>
        <setting key="heated bed temperature">30</setting>
        <setting key="print temperature">210</setting>
        <setting key="retraction amount">0.8</setting>
        <setting key="retraction speed">60.0</setting>
        <cura:setting key="cool_fan_speed_0">0</cura:setting>
        <cura:setting key="cool_fan_speed_max">100</cura:setting>
        <cura:setting key="cool_fan_speed_min">20</cura:setting>
        <cura:setting key="cool_min_layer_time">10.0</cura:setting>
